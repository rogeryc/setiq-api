ENVIRONMENT=development
LOG_LEVEL=INFO

# Native local Postgres (peer auth, no password).
# Replace `you` with your local Postgres username (usually your macOS user).
DATABASE_URL=postgresql://you@localhost:5432/setiq

REDIS_URL=redis://localhost:6379/0

# dbmate
DBMATE_MIGRATIONS_DIR=dbmate/migrations
DBMATE_SCHEMA_FILE=dbmate/schema.sql

JWT_SECRET=change_me_use_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

ANTHROPIC_API_KEY=
